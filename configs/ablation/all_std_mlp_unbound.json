            "name": "std",
            "scaling": "standard"
        }
    ],
    "save_models": true,
    "method_n_jobs": 32,
    "methods": [
        "dummy_classifier",
        {"name": "mlp_residual_classifier", "alias": "mlp_residual_weighted", "params": {"loss_fn": "weighted_bce"}}
    ],
    "output": {
        "dir": "results/ablation/"
    }
}